# Anh only: copy to .env.test, configure an already prepared disposable test DB.
# No automatic database creation/reset. Never commit real credentials.
NODE_ENV=test
TEST_DATABASE_URL=postgresql://replace-user:replace-password@localhost:5432/dormflow_test
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUST_PROXY=false
