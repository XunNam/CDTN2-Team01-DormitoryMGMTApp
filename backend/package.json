{
  "name": "dormflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.16.0"
}
