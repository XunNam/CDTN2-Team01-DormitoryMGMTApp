{
  "name": "dormflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "node tools/run-tests.mjs unit",
    "check": "npm run build && npm test",
    "test:unit": "node tools/run-tests.mjs unit",
    "test:integration": "node tools/run-tests.mjs integration",
    "db:check": "node --env-file-if-exists=.env tools/check-db.mjs",
    "db:prepare-test": "node --env-file-if-exists=.env tools/prepare-review-db.mjs",
    "test:system": "node tools/run-tests.mjs system",
    "test:frontend": "node tools/verify-frontend.mjs",
    "db:bootstrap-admin": "node --env-file-if-exists=.env tools/bootstrap-admin.mjs",
    "db:verify": "node --env-file-if-exists=.env tools/verify-schema.mjs"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.20.0"
}
